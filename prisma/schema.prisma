generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  users       User[]
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  employee     Employee?
  orders       Order[]

  @@index([email])
}

model Branch {
  id        String     @id @default(uuid())
  name      String
  address   String?
  timezone  String     @default("Africa/Addis_Ababa")
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  employees Employee[]
  orders    Order[]
  products  Product[]

  @@index([isActive])
}

model Employee {
  id       String   @id @default(uuid())
  role     String
  hireDate DateTime @default(now())
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id])
  branchId String
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

// ── Phase 3 models ───────────────────────────────

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]

  @@index([isActive])
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])

  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id])

  orderItems  OrderItem[]

  @@index([branchId, isAvailable])
  @@index([categoryId])
}


enum OrderStatus {
  pending
  confirmed
  in_kitchen
  ready
  completed
  cancelled
}

enum OrderType {
  dine_in
  takeaway
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique  // human-readable e.g. "ORD-0042"
  status      OrderStatus @default(pending)
  type        OrderType   @default(dine_in)
  tableNumber Int?
  notes       String?
  totalAmount Decimal     @db.Decimal(10, 2) @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customerId  String
  customer    User        @relation(fields: [customerId], references: [id])

  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id])

  items       OrderItem[]
  payment     Payment?

  @@index([branchId, status])
  @@index([customerId])
  @@index([orderNumber])
}

model OrderItem {
  id        String   @id @default(uuid())
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)  // snapshot of price at time of order
  notes     String?
  createdAt DateTime @default(now())

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}



enum PaymentMethod {
  chapa  // all digital payments — Telebirr, CBE Birr, M-Pesa, cards — customer picks on Chapa page
  cash   // physical cash at the counter, cashier confirms manually
}

enum PaymentStatus {
  pending    // initialized but customer hasn't paid yet
  completed  // money confirmed received
  failed     // payment was attempted but failed
  refunded   // money returned to customer
}

model Payment {
  id                 String        @id @default(uuid())
  amount             Decimal       @db.Decimal(10, 2)
  method             PaymentMethod @default(chapa)
  status             PaymentStatus @default(pending)

  // These fields are only filled when method = chapa
  // They are null when method = cash
  txRef              String?       @unique  // YOUR reference e.g. "CAFE-ORD-0001-AB12CD34"
  chapaRef           String?               // Chapa's own internal reference
  checkoutUrl        String?               // the URL you send the customer to
  chapaPaymentMethod String?               // which wallet/bank customer used e.g. "telebirr"

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  orderId            String        @unique  // one payment per order
  order              Order         @relation(fields: [orderId], references: [id])

  @@index([status])
  @@index([txRef])
}